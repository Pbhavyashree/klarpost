# Copy to .env and fill in. Everything is optional for local development.

# Signs the session cookie. Required in production: openssl rand -hex 32
SESSION_SECRET=

# Leave empty locally to use the built-in PGlite database (stored in .data/).
# docker-compose sets this for you.
DATABASE_URL=
POSTGRES_PASSWORD=

# AI extraction. Without a key, the offline rules engine is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Telegram reminders. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram sends it back with every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Local development: 1 = `npm run dev` also fetches the bot's messages and sends reminders.
# Production: leave at 0, use the webhook (scripts/set-webhook.ts) and the worker container.
TELEGRAM_POLLING=0

# Public https URL of the app (for webhook setup and "Open letter" buttons).
APP_URL=

# Protects POST /api/cron/reminders if you trigger reminders from an external scheduler.
CRON_SECRET=
